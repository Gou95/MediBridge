<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".Activities.StockistActivity">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="10dp"
        >


        <ImageView
            android:id="@+id/img_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/backarrow"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/txt_stockist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Stockists List"
            android:textColor="@color/black"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:fontFamily="@font/poppins_semibold"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:layout_centerInParent="true"
            android:gravity="center"

            />

        <ImageView
            android:id="@+id/img_addStockist"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/add"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>


    </RelativeLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="11dp"

        >

        <AutoCompleteTextView
            android:id="@+id/auto_stockist"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@null"
            android:drawableStart="@drawable/baseline_search"
            android:hint="search by stockist "
            android:textColorHint="@color/green"
            android:fontFamily="@font/poppins"
            android:paddingStart="20dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:drawablePadding="10dp"
            android:completionThreshold="1"

            />


    </androidx.cardview.widget.CardView>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/recyclerView"
        android:layout_marginTop="10dp"/>

</LinearLayout>