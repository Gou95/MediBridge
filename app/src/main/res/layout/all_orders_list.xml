<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txt_all_OrderSerial"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:fontFamily="@font/gotham_bold"
                android:textColor="@color/black"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"/>




            <TextView
                android:id="@+id/txt_all_OrderMedicineNm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/gotham_bold"
                android:textColor="@color/black"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"/>

        </LinearLayout>

        <TextView
            android:id="@+id/txt_all_OrderDot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/gotham_bold"
            android:textColor="@color/black"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"/>
        <LinearLayout
            android:id="@+id/linear_all_OrderLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txt_all_OrderUnitName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gotham_bold"
                android:textColor="@color/purple_700"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/txt_all_OrderUnitNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/gotham_bold"
                android:textColor="@color/black"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"/>

        </LinearLayout>


        <TextView
            android:id="@+id/txt_all_OrderUnlisted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:fontFamily="@font/gotham_bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:visibility="gone"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gotham_bold"
                android:text="Stockist Name :"
                android:textColor="@color/black"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/txt_all_OrderStockitName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/gotham_bold"
                android:textColor="@color/black"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gotham_bold"
                android:text="Delivery Day :"
                android:textColor="@color/black"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/txt_all_orderDeliDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/gotham_bold"
                android:textColor="@color/black"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"/>

        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal"
            >


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gotham_bold"
                android:text="Order Status :"
                android:textColor="@color/black"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"/>

            <TextView
                android:id="@+id/txt_all_OrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/gotham_bold"
                android:textColor="@color/yellow"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"/>

        </LinearLayout>

        <!--        <TextView-->
        <!--            android:id="@+id/txt_expire"-->
        <!--            android:layout_width="match_parent"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:gravity="end"-->
        <!--            android:text="Expire"-->
        <!--            android:autoSizeTextType="uniform"-->
        <!--            android:autoSizeMinTextSize="16sp"-->
        <!--            android:autoSizeMaxTextSize="18sp"-->
        <!--            android:autoSizeStepGranularity="1sp"-->
        <!--            android:textColor="@color/black"-->
        <!--            android:fontFamily="@font/gotham_bold"-->
        <!--            android:layout_marginEnd="10dp"/>-->


    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_all_cancelItem"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Cancel Item"
        android:layout_gravity="end"
        android:backgroundTint="@color/yellow"
        android:textColor="@color/white"
        app:cornerRadius="20dp"
        android:textAllCaps="false"
        android:gravity="center"
        android:fontFamily="@font/gotham_bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="13sp"
        android:autoSizeStepGranularity="1sp"
        android:importantForAccessibility="no"
        android:includeFontPadding="false"


        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recieved"
            android:textColor="@color/black"
            android:layout_marginEnd="4dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:fontFamily="@font/gotham_bold"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"/>

        <FrameLayout
            android:id="@+id/all_boxPed"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/box_border"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="5dp">

            <ImageView
                android:id="@+id/all_imgTick"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/checkmark"
                android:visibility="gone" />
        </FrameLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not Recieved"
            android:textColor="@color/black"
            android:layout_marginStart="10dp"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:fontFamily="@font/gotham_bold"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"/>

        <FrameLayout
            android:id="@+id/all_boxNotPed"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/box_border"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="5dp">

            <ImageView
                android:id="@+id/all_imgNotPedStatus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="4dp"
                android:scaleType="centerInside"
                android:src="@drawable/close"
                android:visibility="gone" />
        </FrameLayout>



    </LinearLayout>

    <LinearLayout
        android:id="@+id/linear_all_expiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/txt_all_expiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register Expiry "
            android:textColor="@color/red"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:fontFamily="@font/gotham_bold"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"

            />

        <TextView
            android:id="@+id/txt_all_expiryMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/green"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="14sp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeStepGranularity="1sp"
            android:fontFamily="@font/gotham_bold"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="20dp"
            android:maxLines="1"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            />
    </LinearLayout>




    <View
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:layout_marginTop="10dp"
        android:background="@color/grey" />

</LinearLayout>