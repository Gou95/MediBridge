<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/pos_cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        app:cardElevation="10dp"
        android:layout_margin="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="5dp">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/img_logo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/logomedi" />

                <LinearLayout
                    android:layout_toRightOf="@id/img_logo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:text="Cash Memo  : "
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14dp"
                            />

                        <TextView
                            android:id="@+id/txt_billNo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14dp"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:text="Doctor Name :"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14dp"
                            />

                        <TextView
                            android:id="@+id/txt_doctorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/green"
                            android:text=""
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginStart="5dp"
                            android:textSize="14dp"
                            />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:text="Patient Name :"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14dp"
                            />

                        <TextView
                            android:id="@+id/txt_patientName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/green"
                            android:text=""
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginStart="5dp"
                            android:textSize="14dp"
                            />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"

                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:text="Date : "
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14dp"
                            />

                        <TextView
                            android:id="@+id/txt_billDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="date time"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14dp"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        >

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:text="Total sold items :"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14dp"
                            />

                        <TextView
                            android:id="@+id/txt_totalItems"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/green"
                            android:text="00"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginStart="5dp"
                            android:textSize="14dp"
                            />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:text="Total bill amount :"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="14dp"
                            />

                        <TextView
                            android:id="@+id/txt_billAmt"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/green"
                            android:text="00"
                            android:fontFamily="@font/poppins_semibold"
                            android:layout_marginStart="5dp"
                            android:textSize="14dp"
                            />

                    </LinearLayout>

                </LinearLayout>


                <androidx.cardview.widget.CardView
                    android:id="@+id/card_background"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    app:cardCornerRadius="15dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txt_status"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="14sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:autoSizeStepGranularity="1sp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_semibold"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"/>


                </androidx.cardview.widget.CardView>


            </RelativeLayout>


