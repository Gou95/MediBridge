<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Activities.PosActivity">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/swipe_refresh_layout"
        android:layout_above="@id/linearLayout"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="15dp"
                android:padding="10dp">


                <ImageView
                    android:id="@+id/img_back"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/backarrow"
                    android:layout_centerVertical="true"/>

                <TextView
                    android:id="@+id/txt_expiryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Daily Sales Register"
                    android:textColor="@color/black"
                    android:textSize="16dp"
                    android:fontFamily="@font/gotham_bold"
                    android:layout_marginHorizontal="20dp"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:layout_marginTop="20dp"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"/>



            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/edit_background"
                android:orientation="vertical"
                android:layout_margin="10dp"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_margin="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date : "
                        android:textSize="16dp"
                        android:fontFamily="@font/gotham_bold"
                        android:textColor="@color/black"/>

                    <TextView
                        android:id="@+id/txt_posDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="11-07-2025"
                        android:textSize="16dp"
                        android:fontFamily="@font/gotham_bold"
                        android:textColor="@color/black"
                        android:layout_marginStart="10dp"/>


                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Medicine for sale "
                    android:textSize="16dp"
                    android:fontFamily="@font/gotham_bold"
                    android:textColor="@color/black"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"/>


                <androidx.cardview.widget.CardView
                    android:id="@+id/cardView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="10dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="11dp"
                    android:layout_marginBottom="10dp"
                    >

                    <AutoCompleteTextView
                        android:id="@+id/auto_medi"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@null"
                        android:drawableStart="@drawable/baseline_search"
                        android:hint="search medicine "
                        android:textColorHint="@color/green"
                        android:fontFamily="@font/gothambold"
                        android:paddingStart="20dp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="16sp"
                        android:autoSizeMaxTextSize="18sp"
                        android:autoSizeStepGranularity="1sp"
                        android:drawablePadding="10dp"
                        android:completionThreshold="1"

                        />


                </androidx.cardview.widget.CardView>


            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="List of Sold Medicine "
                android:textSize="16dp"
                android:fontFamily="@font/gotham_bold"
                android:textColor="@color/black"
              android:layout_marginTop="5dp"
                android:layout_marginStart="10dp"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:background="@drawable/edit_background"
                android:layout_marginTop="5dp"
                android:layout_marginHorizontal="10dp">
                <TextView
                    android:id="@+id/txt_posProductName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Product Name"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:fontFamily="@font/gotham_bold"/>

                <TextView
                    android:id="@+id/txt_posQty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Qty"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:fontFamily="@font/gotham_bold"/>

                <TextView
                    android:id="@+id/txt_posUnitNM"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Unit"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:fontFamily="@font/gotham_bold"/>

                <TextView
                    android:id="@+id/txt_posAmount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Amount"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:fontFamily="@font/gotham_bold"/>



            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:layout_marginHorizontal="10dp"
                android:id="@+id/recyclerView"


                />

        </LinearLayout>


    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="10dp"
        android:background="@drawable/edit_background"
        android:padding="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_above="@id/relativeLayout">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Sold Medicine"
                android:textSize="16dp"
                android:textColor="@color/black"
                android:fontFamily="@font/gotham_bold"
                />

            <TextView
                android:id="@+id/txt_soldMedicine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.00"
                android:textSize="16dp"
                android:textColor="@color/black"
                android:fontFamily="@font/gotham_bold"
                android:layout_alignParentEnd="true"
                />



        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relativeLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Sale Value"
                android:textSize="16dp"
                android:textColor="@color/black"
                android:fontFamily="@font/gotham_bold"
                />

            <TextView
                android:id="@+id/txt_totalAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00.00"
                android:textSize="16dp"
                android:textColor="@color/black"
                android:fontFamily="@font/gotham_bold"
                android:layout_alignParentEnd="true"
                />



        </RelativeLayout>


    </LinearLayout>


</RelativeLayout>