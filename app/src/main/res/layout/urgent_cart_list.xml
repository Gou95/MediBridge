        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <ImageView
                android:id="@+id/img_urgentLogo"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/logomedi"
                android:layout_centerVertical="true"/>

            <LinearLayout
                android:layout_toRightOf="@id/img_urgentLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp"

                >
                <TextView
                    android:id="@+id/txt_removeMedicineNm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Paracetamol"
                    android:textColor="@color/black"
                  android:fontFamily="@font/gotham_bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"/>
                <TextView
                    android:id="@+id/txt_removestockitName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stocket name"
                    android:textColor="@color/green"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:fontFamily="@font/gotham_bold"
                    android:layout_marginTop="5dp"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    />
                <LinearLayout
                    android:id="@+id/linear_urgentUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="5dp">


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unit :"
                        android:textColor="@color/black"
                        android:fontFamily="@font/gotham_bold"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="14sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:autoSizeStepGranularity="1sp"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"/>

                    <TextView
                        android:id="@+id/txt_removeUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="bottles"
                        android:textColor="@color/purple_700"
                        android:fontFamily="@font/gotham_bold"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="14sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:autoSizeStepGranularity="1sp"
                        android:layout_marginStart="10dp"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"/>




                </LinearLayout>
                <TextView
                    android:id="@+id/unlistedMedicine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:fontFamily="@font/gotham_bold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:visibility="gone"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"/>





            </LinearLayout>

