<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".Activities.CashMemoActivity">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/swipe_refresh_layout"
        android:layout_above="@id/linearlayout"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:background="@color/green"
                >


                <ImageView
                    android:id="@+id/img_back"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/backarrow"
                    android:layout_centerVertical="true"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/txt_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cash Memo"
                    android:textColor="@color/white"
                    android:layout_centerInParent="true"
                    android:gravity="center"
                    android:textSize="16dp"
                    android:fontFamily="@font/poppins_regular"

                    />

            </RelativeLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignParentBottom="true"
                    android:gravity="center"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    >
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btn_reset"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="25dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/grey"
                        >

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="Reset "
                            android:textColor="@color/black"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="14sp"
                            android:autoSizeMaxTextSize="16sp"
                            android:autoSizeStepGranularity="1sp"
                            android:importantForAccessibility="no"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_weight="1">

                         <TextView
                            android:id="@+id/txt_totalCashMemo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                             android:autoSizeTextType="uniform"
                             android:autoSizeMinTextSize="15sp"
                             android:autoSizeMaxTextSize="16sp"
                             android:autoSizeStepGranularity="1sp"
                             android:importantForAccessibility="no"
                             android:includeFontPadding="false"
                            android:gravity="center"
                            android:fontFamily="@font/poppins"
                            android:textColor="@color/black"/>


                    </LinearLayout>

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- 🔍 SEARCH EDITTEXT -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <EditText
                                android:id="@+id/et_search"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toStartOf="@+id/img_voice"
                                android:background="@drawable/bg_search"
                                android:drawableStart="@drawable/baseline_search"
                                android:drawablePadding="8dp"
                                android:padding="12dp"
                                android:fontFamily="@font/poppins"
                                android:hint="Search for demands"
                                android:textColor="@color/black"
                                android:textColorHint="@color/green"
                                android:inputType="text"
                                />

                            <ImageView
                                android:id="@+id/img_voice"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:padding="6dp"
                                android:src="@drawable/microphone"/>
                        </RelativeLayout>

                        <!-- 🔽 SEARCH RESULT LIST -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_search"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:visibility="gone"
                            android:overScrollMode="never"
                            />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                 <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textColor="@color/black"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginHorizontal="10dp"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"
                    android:layout_marginTop="10dp"/>


                <EditText
                    android:id="@+id/edt_date"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/edit_background"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/black"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:paddingLeft="10dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Doctor Name"
                    android:textColor="@color/black"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="5dp"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"/>


                <EditText
                    android:id="@+id/edt_docterNm"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/edit_background"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:fontFamily="@font/poppins_regular"
                    android:paddingLeft="10dp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:layout_marginBottom="10dp"/>


                <TextView

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Patient name"
                    android:textColor="@color/black"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:fontFamily="@font/poppins_regular"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="5dp"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"/>


                <EditText
                    android:id="@+id/edt_patient"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/edit_background"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="10dp"
                    android:paddingLeft="10dp"
                    android:imeOptions="actionNext"
                    android:fontFamily="@font/poppins_regular"
                    android:inputType="text"
                    android:layout_marginBottom="10dp"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"/>




                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="10dp"
                    android:background="@drawable/edit_background"
                    android:layout_marginTop="5dp"
                    android:layout_marginHorizontal="10dp">
                    <TextView
                        android:id="@+id/txt_posProductName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Product Name"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semibold"/>
                    <TextView
                        android:id="@+id/txt_posUnitNM"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Unit"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"/>
                    <TextView
                        android:id="@+id/txt_posBatch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Batch"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"/>
                    <TextView
                        android:id="@+id/txt_posExpiry"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Expiry"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"/>
                    <TextView
                        android:id="@+id/txt_posQty"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Qty"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"/>



                    <TextView
                        android:id="@+id/txt_posAmount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Amount"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        android:gravity="center"
                        android:fontFamily="@font/poppins_semibold"/>



                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="10dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginHorizontal="10dp"
                        android:id="@+id/recyclerView"/>

                    <LinearLayout
                        android:id="@+id/linear_hide"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone"
                        android:padding="16dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:src="@drawable/empty"
                            android:layout_gravity="center"
                             app:civ_border_color="#FF000000"
                            app:civ_border_width="1dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cart is empty"
                            android:autoSizeTextType="uniform"
                            android:autoSizeMinTextSize="14sp"
                            android:autoSizeMaxTextSize="16sp"
                            android:autoSizeStepGranularity="1sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="10dp" />
                    </LinearLayout>

                </FrameLayout>


            </LinearLayout>



        </LinearLayout>


    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:id="@+id/linearlayout"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp"
        >



        <androidx.cardview.widget.CardView
            android:id="@+id/btn_addBill"
            android:layout_width="0dp"
            android:layout_height="40dp"
            app:cardCornerRadius="25dp"
            app:cardBackgroundColor="@color/green"
            android:layout_weight="1"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Create Bill "
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="@font/gotham_bold"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_pdf"
            android:layout_width="0dp"
            android:layout_height="40dp"
            app:cardCornerRadius="25dp"
            app:cardBackgroundColor="@color/yellow"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            >

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Generate Pdf "
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="@font/gotham_bold"
                android:gravity="center" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>



</RelativeLayout>