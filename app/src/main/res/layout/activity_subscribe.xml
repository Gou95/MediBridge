<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Activities.SubscribeActivity">

    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:src="@drawable/medione" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/gotham_bold"
        android:text="MediBro"
        android:textColor="@color/purple_700"
        android:textSize="30sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/gotham_bold"
        android:text="Subscribe Now"
        android:textColor="@color/black"
        android:textSize="20sp" />


<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp">

    <RadioGroup
        android:id="@+id/planGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/radioYearly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yearly Plan"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:fontFamily="@font/gotham_bold"
            />
        <RadioButton
            android:id="@+id/radioSixMonths"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Six Months Plan"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:fontFamily="@font/gotham_bold"
            />
        <RadioButton
            android:id="@+id/radioThreeMonths"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Three Months Plan"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:fontFamily="@font/gotham_bold"
            />
        <RadioButton
            android:id="@+id/radioFree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Free Plan (1 Month)"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:fontFamily="@font/gotham_bold"
            />

    </RadioGroup>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/txt_yearly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="₹999"
            android:textColor="@color/purple_700"
            android:textSize="16sp"
            android:fontFamily="@font/gotham_bold"
            android:layout_marginTop="20dp"/>
        <TextView
            android:id="@+id/txt_six"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="₹599"
            android:textColor="@color/purple_700"
            android:textSize="16sp"
            android:fontFamily="@font/gotham_bold"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/txt_three"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="₹399"
            android:textColor="@color/purple_700"
            android:textSize="16sp"
            android:fontFamily="@font/gotham_bold"
            android:layout_marginTop="30dp"/>
        <TextView
            android:id="@+id/txt_free"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="₹0"
            android:textColor="@color/purple_700"
            android:textSize="16sp"
            android:fontFamily="@font/gotham_bold"
            android:layout_marginTop="30dp"/>
    </LinearLayout>



</RelativeLayout>


    <androidx.cardview.widget.CardView
        android:id="@+id/btn_submit"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/green"
        app:cardCornerRadius="25dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/gotham_bold"
            android:gravity="center"
            android:text="Pay Now "
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />


    </androidx.cardview.widget.CardView>


</LinearLayout>