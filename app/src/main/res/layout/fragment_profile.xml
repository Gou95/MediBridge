<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    tools:context=".Fragment.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"

       >

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/img_profile"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/profile"
          />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MediBro"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:fontFamily="@font/gotham_bold" />

            <TextView
                android:id="@+id/txt_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/gotham_bold"
                android:textColor="@color/black"
                android:textSize="16sp" />

        </LinearLayout>



    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">


        <TextView
            android:id="@+id/txt_editProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableLeft="@drawable/baseline_edit"
            android:drawablePadding="10dp"
            android:fontFamily="@font/gotham_bold"
            android:text="Edit Profile"
            android:textColor="@color/dark_gray"
            android:textSize="18sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="@color/grey" />


        <TextView
            android:id="@+id/txt_chat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/baseline_chat"
            android:drawablePadding="10dp"
            android:text="Chat"
            android:textColor="@color/dark_gray"
            android:textSize="18sp"
            android:fontFamily="@font/gotham_bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="@color/grey" />

        <TextView
            android:id="@+id/txt_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/baseline_area_chart"
            android:drawablePadding="10dp"
            android:text="Address"
            android:textColor="@color/dark_gray"
            android:textSize="18sp"
            android:fontFamily="@font/gotham_bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="@color/grey" />

        <TextView
            android:id="@+id/txt_changePass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/baseline_key"
            android:drawablePadding="10dp"
            android:text="Change Password"
            android:textColor="@color/dark_gray"
            android:textSize="18sp"
            android:fontFamily="@font/gotham_bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="@color/grey" />


        <TextView
            android:id="@+id/txt_TermsCndition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/terms"
            android:drawablePadding="10dp"
            android:text="Terms &amp; Conditions"
            android:textColor="	@color/dark_gray"
            android:textSize="18sp"
            android:fontFamily="@font/gotham_bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="@color/grey" />

        <TextView
            android:id="@+id/txt_privacyPolicy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/privacy"
            android:drawablePadding="10dp"
            android:text="Privacy Policy"
            android:textColor="@color/dark_gray"
            android:textSize="18sp"
            android:fontFamily="@font/gotham_bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="@color/grey" />
        <TextView
            android:id="@+id/txt_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/planning"
            android:drawablePadding="10dp"
            android:text="Select Plans"
            android:textColor="@color/dark_gray"
            android:gravity="center_vertical"
            android:textSize="18sp"
            android:fontFamily="@font/gotham_bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="@color/grey" />

        <TextView
            android:id="@+id/txt_invoice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/download"
            android:drawablePadding="10dp"
            android:text="Download Invoice"
            android:textColor="@color/dark_gray"
            android:gravity="center_vertical"
            android:textSize="18sp"
            android:fontFamily="@font/gotham_bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="@color/grey" />

        <TextView
            android:id="@+id/txt_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:drawableLeft="@drawable/baseline_logout"
            android:drawablePadding="10dp"
            android:text="Logout"
            android:textColor="@color/dark_gray"
            android:textSize="18sp"
            android:fontFamily="@font/gotham_bold" />


        <View
            android:layout_width="match_parent"
            android:layout_height="1.5dp"
            android:layout_marginTop="10dp"
            android:background="@color/grey" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current Subscription Plan :"
                android:textColor="@color/green"
                android:textSize="18sp"
                android:fontFamily="@font/gotham_bold"
                />

            <TextView
                android:id="@+id/txt_subs_plan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gotham_bold"
                android:textColor="@color/green"
                android:textSize="18sp"
                android:layout_marginStart="5dp"/>





        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remaining Subscription Days :"
                android:textColor="@color/dark_gray"
                android:textSize="18sp"
                android:fontFamily="@font/gotham_bold"
              />

            <TextView
                android:id="@+id/txt_subs_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gotham_bold"
                android:textColor="@color/dark_gray"
                android:textSize="18sp"
                android:layout_marginStart="5dp"/>





        </LinearLayout>

    </LinearLayout>
</LinearLayout>