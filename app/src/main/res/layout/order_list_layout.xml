<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="wrap_content">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="10dp"
        android:layout_marginTop="20dp"
        app:cardElevation="10dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginHorizontal="10dp"
            android:layout_marginTop="5dp">


            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/img_logo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/logomedi" />

                <LinearLayout
                    android:layout_toRightOf="@id/img_logo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">


                    <TextView
                        android:id="@+id/txt_dateOftime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="date time"
                        android:textColor="@color/black"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="14sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:autoSizeStepGranularity="1sp"
                        android:fontFamily="@font/poppins_semibold"
                        android:layout_marginTop="5dp"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"/>


                    <TextView
                        android:id="@+id/txt_dealer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="14sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:autoSizeStepGranularity="1sp"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"/>


                    <TextView
                        android:id="@+id/txt_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/green"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="14sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:autoSizeStepGranularity="1sp"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"/>


                </LinearLayout>


                <androidx.cardview.widget.CardView
                    android:id="@+id/card_background"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    app:cardCornerRadius="15dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txt_status"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="14sp"
                        android:autoSizeMaxTextSize="16sp"
                        android:autoSizeStepGranularity="1sp"
                        android:gravity="center"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_semibold"
                        android:importantForAccessibility="no"
                        android:includeFontPadding="false"/>


                </androidx.cardview.widget.CardView>


            </RelativeLayout>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:id="@+id/txt_item_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total number of items :"
                    android:textColor="@color/black"
                    android:fontFamily="@font/poppins_semibold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"


                   />
                <TextView
                    android:layout_toRightOf="@id/txt_item_label"
                    android:id="@+id/txt_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeStepGranularity="1sp"
                    android:importantForAccessibility="no"
                    android:includeFontPadding="false"/>


            </RelativeLayout>
            <TextView
                android:id="@+id/txt_allDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="See All Details"
                android:textColor="@color/green"
                android:fontFamily="@font/poppins_semibold"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp"
                android:maxLines="1"
                android:layout_marginBottom="10dp"
                android:layout_gravity="end"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                />



        </LinearLayout>


    </androidx.cardview.widget.CardView>

</LinearLayout>